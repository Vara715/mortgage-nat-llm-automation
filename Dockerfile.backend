# Dockerfile.backend
FROM python:3.13-slim

WORKDIR /app

# Install system dependencies (Poppler and Tesseract for PDF/OCR)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    tesseract-ocr \
    poppler-utils \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code and data
COPY backend /app/backend
COPY data /app/data
COPY pyproject.toml .

# Environment configuration
ENV PYTHONPATH=/app
ENV PORT=8000

EXPOSE 8000

# Run pre-seeding and launch FastAPI server
CMD python backend/scripts/seed_data.py && uvicorn backend.app.main:app --host 0.0.0.0 --port 8000
