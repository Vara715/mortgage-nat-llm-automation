# ==============================================================================
# morgage-loan-automation Environment Configuration
# ==============================================================================

PROJECT_NAME=morgage-loan-automation
ENVIRONMENT=development
VERSION=1.0.0

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# High-speed local SQLite with WAL mode (default for development/testing):
DATABASE_URL=sqlite:///data/processed/mortgageguard.db

# Production PostgreSQL with pgvector (used in docker-compose.yml):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mortgage_db

# ------------------------------------------------------------------------------
# Message Broker & Orchestration
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
N8N_WEBHOOK_URL=http://localhost:5678

# ------------------------------------------------------------------------------
# Security & JWT Authentication
# ------------------------------------------------------------------------------
SECRET_KEY=dev-secret-key-change-in-production-32chars
ACCESS_TOKEN_EXPIRE_MINUTES=480
RATE_LIMIT_ENABLED=true
CORS_ORIGINS=["*"]

# ------------------------------------------------------------------------------
# AI, LLM & Embedding Model Configuration
# ------------------------------------------------------------------------------
# LLM Provider: 'mock_or_env', 'openai', 'groq', or 'nim'
LLM_PROVIDER=mock_or_env
DEFAULT_LLM_MODEL=meta/llama-3-70b-instruct
OPENAI_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=

# Embedding Provider: 'tfidf_dense', 'sentence_transformers', or 'openai'
EMBEDDING_PROVIDER=tfidf_dense
EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# Retrieval & Jurisdiction Parameters
# ------------------------------------------------------------------------------
HYBRID_SEARCH_TOP_K=5
BM25_WEIGHT=0.6
DENSE_WEIGHT=0.4
MIN_SIMILARITY_SCORE=0.15
